<.tlc_page_container>
  <%
    display_program = cond do
      @editing -> @edited_program
      @saved_program != nil -> @saved_program
      true -> @tlc.logic.program
    end

    # logic_type is the type of the currently running logic (used for header/time display)
    logic_type = get_logic_type(@tlc.logic)
    # program_type is the type for the currently displayed program (the editor/preview)
    program_type = get_program_type(display_program)
    groups = get_groups(@tlc.logic)
    logic_is_fixed_time = logic_type == :fixed_time
    logic_current_cycle = if logic_is_fixed_time, do: @tlc.logic.cycle_time, else: 0
    logic_offset = if logic_is_fixed_time, do: @tlc.logic.offset, else: 0
    logic_target_offset = if logic_is_fixed_time, do: @tlc.logic.target_offset, else: nil
    logic_target_distance = if logic_is_fixed_time, do: @tlc.logic.target_distance, else: nil
  %>

  <!-- Common Header: Program selector, Mode, Signal lamps -->
  <.common_header
    programs={@tlc.programs}
    current_program={@tlc.logic.program}
    target_program={@target_program}
    logic_type={logic_type}
    logic={@tlc.logic}
    mode={@tlc.logic.mode}
    groups={groups}
    current_states={@tlc.logic.current_states}
    interval={@tlc.interval}
    selected_interval={@selected_interval}
    paused={@paused}
    editing={@editing}
  />

  <!-- Program section (common): selectors at the top, type-specific details below) -->
  <div class="overflow-x-auto" style="margin-bottom: 0.5rem;">
    <div class="bg-gray-800 p-3 rounded shadow-lg border border-gray-700 mb-3">
      <h3 class="text-lg font-semibold text-gray-200 mb-2">Program</h3>
      <.program_controls
        programs={@tlc.programs}
        logic_mode={@tlc.logic.mode}
        current_program={@tlc.logic.program}
        target_program={@target_program}
        editing={@editing}
        edited_program={@edited_program}
        auto={@auto}
      />
        <div class="mt-3 flex flex-col gap-3">
          <div class="w-full">
            <%= if program_type == :fixed_time do %>
              <.fixed_time_program_preview program={display_program} />
            <% else %>
              <.stage_based_program_preview program={display_program} />
            <% end %>
          </div>
          <div class="w-full overflow-x-auto">
            <%= if program_type == :fixed_time do %>
              <.program_editor_container
                display_program={display_program}
                edited_program={@edited_program}
                current_program={@tlc.logic.program}
                current_cycle={logic_current_cycle}
                editing={@editing}
                offset={logic_offset}
                target_offset={logic_target_offset}
                target_distance={logic_target_distance}
                invalid_transitions={@invalid_transitions}
                next_signal_fn={&next_signal/1}
                is_between_offsets_fn={&is_between_offsets/3}
                logic={@tlc.logic}
                interval={@tlc.interval}
                selected_interval={@selected_interval}
                paused={@paused}
                programs={@tlc.programs}
                logic_mode={@tlc.logic.mode}
                target_program={@target_program}
                program_text={@program_text}
                json_error={@json_error}
                validation_error={@validation_error}
              />
            <% else %>
              <.transition_grid logic={@tlc.logic} />
            <% end %>
          </div>
        </div>
      </div>
  </div>

  <!-- content moved inside the Program section above -->
</.tlc_page_container>
